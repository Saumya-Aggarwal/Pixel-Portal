# Absolute origin used for canonical URLs, Open Graph tags, and sitemap.xml.
# Falls back to https://pixelportal.com when unset (see src/content/site.ts).
# On Vercel, set this per-environment so previews do not emit production URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Inquiry form delivery (src/app/api/inquiry/route.ts).
# RESEND_API_KEY comes from the Resend dashboard and is shown once, at creation.
# Without it, submissions are logged in development and 502 in production rather
# than being silently dropped.
# INQUIRY_FROM must sit on a domain verified in Resend (pixelportal.in is).
# INQUIRY_TO is only a delivery address, so it need not be on that domain.
RESEND_API_KEY=
INQUIRY_FROM=Pixel Portal <hello@pixelportal.in>
INQUIRY_TO=hello@pixelportal.in
